{
  "name": "noteharbor",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "predev": "pnpm --filter editor_server rebuild better-sqlite3 --verbose",
    "dev": "concurrently \"pnpm --filter editor_server dev\" \"pnpm --filter editor_web dev\"",
    "build:editor:desktop:win": "pnpm --filter editor_desktop build:win",
    "dev:viewer:flutter": "cd apps/viewer/flutter && flutter pub get && flutter run",
    "build:viewer:flutter:windows": "cd apps/viewer/flutter && flutter pub get && flutter build windows",
    "build:viewer:flutter:ios": "cd apps/viewer/flutter && flutter pub get && flutter build ios",
    "start:viewer:react-native": "pnpm --filter viewer_react_native start",
    "dev:viewer:react-native:ios": "pnpm --filter viewer_react_native ios",
    "test:viewer:react-native": "pnpm --filter viewer_react_native test",
    "layout": "tsps --layout layout.yml"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
