{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Note Harbor Editor",
  "version": "2.7.3",
  "identifier": "com.noteharbor.editor",
  "build": {
    "frontendDist": "../../ui-react/dist",
    "beforeDevCommand": "pnpm --dir . build:web:watch",
    "beforeBuildCommand": "pnpm --dir . build:web"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis",
      "appimage"
    ],
    "resources": {
      "../../ui-react/dist": "web-dist"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
