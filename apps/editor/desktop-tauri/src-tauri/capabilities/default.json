{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the Note Harbor Editor Tauri shell.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "allow-get-scrape-browser-status",
    "allow-open-scrape-browser",
    "allow-get-showcase-photo-size",
    "allow-set-showcase-photo-size",
    "allow-get-last-visited-route",
    "allow-set-last-visited-route"
  ]
}
