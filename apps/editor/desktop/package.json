{
  "name": "editor_desktop",
  "private": true,
  "version": "1.18.0",
  "description": "Electron-packaged Note Harbor Editor",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "build:web": "node ./scripts/build-web.mjs",
    "prepare:package": "node ./scripts/prepare-package.mjs",
    "reset:native-stamps": "node ./scripts/reset-native-stamps.mjs",
    "build": "pnpm run build:web && pnpm run prepare:package && pnpm run reset:native-stamps && electron-builder install-app-deps && electron-builder",
    "build:windows": "pnpm run build:web && pnpm run prepare:package && pnpm run reset:native-stamps && electron-builder install-app-deps && electron-builder --win nsis portable",
    "pack": "pnpm run build:web && pnpm run prepare:package && pnpm run reset:native-stamps && electron-builder install-app-deps && electron-builder --dir"
  },
  "dependencies": {
    "@img/sharp-darwin-arm64": "0.35.5",
    "@img/sharp-win32-x64": "0.35.5",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "playwright-core": "^1.64.0",
    "sharp": "^0.35.5",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.noteharbor.editor",
    "productName": "Note Harbor Editor",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "src/**/*",
      ".build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../data",
        "to": "bundled-data"
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "**/*.dll",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Utility"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
